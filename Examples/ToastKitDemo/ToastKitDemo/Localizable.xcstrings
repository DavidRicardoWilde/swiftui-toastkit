    "Swipe either way.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza en cualquier dirección."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらにでもスワイプできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 방향으로든 스와이프하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向任一方向轻扫。"
          }
        },
        "zh-Hant": {
