            "state": "translated",
            "value": "向任一方向滑動。"
          }
        }
      }
    },
    "Swipe left / right, press and hold": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a izquierda/derecha, mantén pulsado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプ、長押し"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
