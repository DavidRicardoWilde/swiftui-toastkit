    "Starts as Connecting…, then fills. Cancel is on the card. Success plays a selection haptic. Compact shows the percentage only.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza como «Conectando…» y luego se llena. Cancelar está en la tarjeta. Al completarse suena una respuesta háptica de selección. Compacto solo muestra el porcentaje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「接続中…」から始まり、その後バーが伸びます。キャンセルはカード上にあります。成功時には選択ハプティクスが再生されます。コンパクトでは割合のみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘연결 중…’으로 시작한 뒤 채워집니다. 취소는 카드에 있습니다. 성공 시 선택 햅틱이 재생됩니다. 컴팩트는 백분율만 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以“正在连接…”开始，然后填充。取消按钮位于卡片上。成功时会播放选择触感反馈。紧凑仅显示百分比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以「正在連接…」開始，然後填充。取消按鈕位於卡片上。成功時會播放選擇觸覺回饋。精簡僅顯示百分比。"
          }
        }
      }
    },
    "Starts indeterminate, then switches to a bar. Look at a card to see its hover effect on the buttons. There are no haptics on visionOS.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza indeterminado y luego cambia a una barra. Mira una tarjeta para ver el efecto de hover en los botones. En visionOS no hay respuestas hápticas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定進捗で始まり、その後バーに切り替わります。カードを注視すると、ボタンのホバー効果を確認できます。visionOS にはハプティクスはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불확정 진행률로 시작한 뒤 막대로 전환됩니다. 카드를 바라보면 버튼의 호버 효과를 볼 수 있습니다. visionOS에는 햅틱이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以不确定进度开始，然后切换为进度条。查看卡片可了解其按钮的悬停效果。visionOS 上没有触感反馈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以不確定進度開始，然後切換為進度條。查看卡片可了解其按鈕的懸停效果。visionOS 上沒有觸覺回饋。"
          }
        }
      }
    },
    "Stays until dismissed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece hasta que se descarte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるまで表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫을 때까지 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直保留，直到被关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一直保留，直到被關閉。"
          }
        }
      }
    },
    "Stays until you swipe it away.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece hasta que lo deslices fuera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプして消すまで表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프로 없앨 때까지 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直保留，直到你轻扫将其划走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一直保留，直到你滑動將其滑走。"
          }
        }
      }
    },
