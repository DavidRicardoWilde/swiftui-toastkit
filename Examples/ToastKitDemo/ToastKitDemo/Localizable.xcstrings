      }
    },
    "Swipe left or right, or press and hold to see both actions.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a izquierda o derecha, o mantén pulsado para ver ambas acciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプするか、長押しすると両方のアクションが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽이나 오른쪽으로 스와이프하거나 길게 눌러 두 동작을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或向右轻扫，或按住以查看两个操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左或向右滑動，或按住以查看兩個動作。"
          }
        }
      }
    },
    "Swipe right to snooze it until later.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para posponerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右にスワイプすると後で再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽으로 스와이프하면 나중에 다시 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右轻扫可将其推迟到稍后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向右滑動可將其延後到稍後。"
          }
        }
      }
    },
    "Swipe this away. It fails in a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza esto fuera. Fallará en unos segundos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをスワイプして消します。数秒後に失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것을 스와이프로 없애세요. 몇 초 후 실패합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
