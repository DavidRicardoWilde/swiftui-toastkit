          "stringUnit": {
            "state": "translated",
            "value": "워치에서는 모든 프리셋이 전체 너비입니다. 컴팩트는 진행률 카드에만 백분율을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
