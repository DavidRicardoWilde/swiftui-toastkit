    "Swipe left or right": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a izquierda o derecha"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左または右にスワイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 또는 오른쪽으로 스와이프"
          }
        },
        "zh-Hans": {
          "stringUnit": {
