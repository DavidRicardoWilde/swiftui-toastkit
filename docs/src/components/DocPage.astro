    { id: 'changelog', eyebrow: '태그, 릴리스 및 변경 기록', description: '태그로 각 버전의 소스를 확인하고 Releases와 변경 기록에서 업데이트 내용을 살펴보세요.', guidance: '코드 차이를 확인하려면 현재 태그와 이전 태그를 비교하세요.', links: [{ label: '태그 보기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: 'Releases 보기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: '변경 기록 보기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: '기여하기', description: '범위가 명확한 수정, 문서 개선과 유용한 예제를 환영합니다.', guidance: 'Pull Request에는 변경 내용과 검증 방법을 간단히 적어 주세요.', links: [{ label: '기여 안내 읽기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
  es: [
    { id: 'github', eyebrow: 'CÓDIGO Y PROYECTO', description: 'ToastKit es una biblioteca SwiftUI de código abierto para notificaciones toast apiladas en iOS.', guidance: 'Consulta el código, la app de ejemplo, la documentación y el historial en el repositorio.', links: [{ label: 'Abrir el repositorio', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: 'PREGUNTAS E IDEAS', description: 'Usa Discussions para preguntas de uso, comentarios generales e ideas que necesiten conversación.', guidance: 'Si surge un error concreto o una solicitud de función, puedes convertirla en un Issue para darle seguimiento.', links: [{ label: 'Abrir Discussions', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
    { id: 'issues', eyebrow: 'ERRORES Y SOLICITUDES', description: 'Usa un Issue para informar de un problema reproducible o solicitar una función concreta.', guidance: 'Incluye pasos, resultado real y esperado, y un ejemplo Swift mínimo. El ejemplo puede contener código incorrecto o que no compile de forma intencional.', links: [{ label: 'Crear un Issue', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/issues/new/choose' }] },
    { id: 'changelog', eyebrow: 'TAGS, VERSIONES Y CAMBIOS', description: 'Consulta los tags para identificar el código de cada versión, Releases para las notas y el changelog para un resumen por versión.', guidance: 'Compara el tag actual con el anterior para revisar los cambios de código.', links: [{ label: 'Ver tags', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: 'Ver Releases', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: 'Leer el changelog', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: 'COLABORA', description: 'Se agradecen correcciones concretas, mejoras de documentación y ejemplos útiles.', guidance: 'Describe brevemente el cambio y cómo lo validaste en tu pull request.', links: [{ label: 'Leer la guía de contribución', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
};
const pageSlugs: Record<string, string> = {
  start: 'get-started', messages: 'toast-messages', timing: 'display-duration', actions: 'gestures-actions',
  styling: 'styles-themes', layout: 'placement-width', sizes: 'sizes', dismissing: 'dismissing-toasts',
  progress: 'progress-toasts', accessibility: 'accessibility', localization: 'app-localization', feedback: 'project-community',
};
const localePrefix = lang === 'en' ? '' : `/${lang}`;
const sectionHref = (id: string) => id === 'overview' ? home : `${localePrefix}/${pageSlugs[id]}/`;
const isCjk = ['zh-cn', 'zh-hant', 'ja', 'ko'].includes(lang);
const home = languageNames.find((language) => language.code === lang)?.href ?? '/';
const activeLanguage = languageNames.find((language) => language.code === lang)?.native ?? 'EN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="1024x1024" href="/icon-1024.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('toastkit-theme');
        const theme = ['light', 'dark', 'system'].includes(savedTheme ?? '') ? savedTheme : 'system';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body data-active-page={activePage}>
    <header class="topbar">
      <a class="brand" href={home} aria-label="ToastKit home">
        <img class="brand-mark" src="/favicon.svg" alt="" width="29" height="29" />
        <span>ToastKit<span class="brand-docs"> / {isCjk ? (lang === 'ja' ? 'ドキュメント' : lang === 'ko' ? '문서' : lang === 'zh-hant' ? '文件' : '文档') : lang === 'es' ? 'Documentación' : 'Docs'}</span></span>
      </a>
      <nav class="top-links" aria-label={isCjk ? (lang === 'ja' ? 'メインナビゲーション' : lang === 'ko' ? '주 탐색' : '主導覽') : lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
        <a href="https://github.com/DavidRicardoWilde/swiftui-toastkit">GitHub <span aria-hidden="true">↗</span></a>
        <details class="theme-menu">
          <summary aria-label={lang === 'ja' ? 'テーマを選択' : lang === 'ko' ? '테마 선택' : lang === 'es' ? 'Elegir tema' : isCjk ? '选择主题' : 'Choose theme'} title={lang === 'ja' ? 'テーマ' : lang === 'ko' ? '테마' : lang === 'es' ? 'Tema' : isCjk ? '主题' : 'Theme'}>
            <span aria-hidden="true">◐</span>
          </summary>
          <div class="theme-options" role="group" aria-label={lang === 'ja' ? 'テーマ' : lang === 'ko' ? '테마' : lang === 'es' ? 'Tema' : isCjk ? '主题' : 'Theme'}>
            <button type="button" data-theme-choice="light">{lang === 'ja' ? 'ライト' : lang === 'ko' ? '라이트' : lang === 'es' ? 'Claro' : isCjk ? '浅色' : 'Light'}</button>
            <button type="button" data-theme-choice="dark">{lang === 'ja' ? 'ダーク' : lang === 'ko' ? '다크' : lang === 'es' ? 'Oscuro' : isCjk ? '深色' : 'Dark'}</button>
            <button type="button" data-theme-choice="system">{lang === 'ja' ? 'システムに合わせる' : lang === 'ko' ? '시스템 설정' : lang === 'es' ? 'Sistema' : isCjk ? '跟随系统' : 'System'}</button>
          </div>
        </details>
        <details class="locale-menu">
          <summary aria-label={lang === 'ja' ? '言語を選択' : lang === 'ko' ? '언어 선택' : lang === 'es' ? 'Seleccionar idioma' : '选择语言'}>{activeLanguage}<span aria-hidden="true">⌄</span></summary>
          <div class="locale-options">
            {languageNames.map((language) => (
              <a href={language.href} lang={language.code === 'zh-hant' ? 'zh-Hant' : language.code} aria-current={language.code === lang ? 'page' : undefined}>
                {language.label}{language.code === lang && <span aria-hidden="true">✓</span>}
              </a>
            ))}
          </div>
        </details>
      </nav>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <label class="sidebar-search">
          <svg class="sidebar-search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8" />
            <path d="m15.5 15.5 4.2 4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span class="sidebar-search-sr-only">{searchCopy[lang].label}</span>
          <input type="search" class="sidebar-search-input" placeholder={searchCopy[lang].placeholder} aria-label={searchCopy[lang].label} aria-keyshortcuts="Meta+K Control+K" />
          <kbd aria-hidden="true">⌘ K</kbd>
        </label>
        <p class="sidebar-search-empty" role="status" hidden>{searchCopy[lang].empty}</p>
        <p class="eyebrow sidebar-guide-label">{guideLabel[lang]}</p>
        <nav class="guide-nav" aria-label={isCjk ? (lang === 'ja' ? 'ドキュメントの各章' : lang === 'ko' ? '문서 섹션' : '文件章節') : lang === 'es' ? 'Secciones de documentación' : 'Documentation sections'}>
          {sections.map(([id, label], index) => (
            <a href={sectionHref(id)} data-mock-folder={isDev && id === 'feedback' ? 'community' : undefined} class:list={['side-link', id === activePage && 'selected']} aria-current={id === activePage ? 'page' : undefined}>
              <span class="nav-number">{String(index).padStart(2, '0')}</span>{label}
              {isDev && id === 'feedback' && <span class="sidebar-mock-chevron" aria-hidden="true">›</span>}
            </a>
          ))}
        </nav>
        {isDev && (
          <div class="sidebar-mock-directory" data-mock-directory>
            <div class="sidebar-subnav" hidden>
              <button class="sidebar-subnav-heading" type="button" aria-label={isCjk ? '返回使用指南' : 'Back to guides'}>
                <span class="sidebar-subnav-arrow" aria-hidden="true">‹</span>
                <span>{sectionLabels[lang][12]}</span>
              </button>
              <a class="side-link selected" href="#mock-community-overview" data-mock-child="overview">
                <span class="nav-number">00</span>{mockOverviewLabel[lang]}
              </a>
              {mockSubsectionLabels[lang].map((label, index) => (
                <a class="side-link" href={`#mock-community-${mockCommunityDetails[lang][index].id}`} data-mock-child={mockCommunityDetails[lang][index].id}>
                  <span class="nav-number">{String(index + 1).padStart(2, '0')}</span>{label}
                </a>
              ))}
            </div>
          </div>
        )}
        <div class="sidebar-note">
          <span class="note-dot"></span>
          <p>{lang === 'ja' ? 'SwiftUI 向け' : lang === 'ko' ? 'SwiftUI 기반' : lang === 'es' ? 'Hecho para SwiftUI' : isCjk ? 'SwiftUI 原生构建' : 'Built for SwiftUI'}</p>
          <small>iOS 17+ · iPadOS 17+</small>
        </div>
      </aside>

      <main id="content">
        <div class="original-document" data-mock-original>
          <slot />
        </div>
        {isDev && activePage !== 'feedback' && (
          <div class="original-document" data-mock-community-original hidden>
            <CommunitySection />
          </div>
        )}
        {isDev && mockCommunityDetails[lang].map((detail, index) => (
          <section class="doc-section mock-community-page" id={`mock-community-${detail.id}`} data-mock-page={detail.id} hidden>
            <div class="section-heading">
              <span class="section-index">12.{String(index + 1).padStart(2, '0')}</span>
              <div><p class="eyebrow">{detail.eyebrow}</p><h2>{mockSubsectionLabels[lang][index]}</h2></div>
            </div>
            <p>{detail.description}</p>
            <div class="callout"><p>{detail.guidance}</p></div>
            <div class="mock-community-links">
              {detail.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}
            </div>
          </section>
        ))}
        <footer class="footer">
          <span>ToastKit · SwiftUI notifications</span>
          <a href="https://github.com/DavidRicardoWilde/swiftui-toastkit">{lang === 'ja' ? 'ソースを見る' : lang === 'ko' ? '소스 보기' : lang === 'es' ? 'Ver código fuente' : isCjk ? '查看源码' : 'View source'} ↗</a>
        </footer>
      </main>

      <aside class="toc-sidebar" aria-label={tocLabel[lang]} hidden>
        <p class="toc-title">{tocLabel[lang]}</p>
        <nav class="toc-list" aria-label={tocLabel[lang]}></nav>
      </aside>
    </div>
<script>
  const themeMenu = document.querySelector<HTMLElement>('.theme-menu');
  const themeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));

  const applyTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('toastkit-theme', theme);
    themeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme));
    });
  };

  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      applyTheme(button.dataset.themeChoice ?? 'system');
      themeMenu?.removeAttribute('open');
    });
  });

  applyTheme(document.documentElement.dataset.theme ?? 'system');

  const navigationLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.guide-nav .side-link'));
  const searchInput = document.querySelector<HTMLInputElement>('.sidebar-search-input');
  const searchEmpty = document.querySelector<HTMLElement>('.sidebar-search-empty');
  const guideNav = document.querySelector<HTMLElement>('.guide-nav');
  const guideLabelElement = document.querySelector<HTMLElement>('.sidebar-guide-label');
  const mockDirectory = document.querySelector<HTMLElement>('[data-mock-directory]');
  const mockFolder = guideNav?.querySelector<HTMLAnchorElement>('[data-mock-folder]');
  const mockSubnav = mockDirectory?.querySelector<HTMLElement>('.sidebar-subnav');
  const mockBack = mockDirectory?.querySelector<HTMLButtonElement>('.sidebar-subnav-heading');
  const currentDocument = document.querySelector<HTMLElement>('[data-mock-original]');
  const mockCommunityOriginal = document.querySelector<HTMLElement>('[data-mock-community-original]');
  const overviewUsesCurrentDocument = document.body.dataset.activePage === 'feedback';
  const mockPages = Array.from(document.querySelectorAll<HTMLElement>('[data-mock-page]'));
  const mockChildren = Array.from(mockDirectory?.querySelectorAll<HTMLAnchorElement>('[data-mock-child]') ?? []);
  const setMockPage = (pageId: string) => {
    const isOverview = pageId === 'overview';
    if (currentDocument) currentDocument.hidden = isOverview ? !overviewUsesCurrentDocument : true;
    if (mockCommunityOriginal) mockCommunityOriginal.hidden = isOverview ? overviewUsesCurrentDocument : true;
    mockPages.forEach((page) => { page.hidden = page.dataset.mockPage !== pageId; });
    mockChildren.forEach((link) => link.classList.toggle('selected', link.dataset.mockChild === pageId));
  };
  const restoreCurrentDocument = () => {
    if (currentDocument) currentDocument.hidden = false;
    if (mockCommunityOriginal) mockCommunityOriginal.hidden = true;
    mockPages.forEach((page) => { page.hidden = true; });
  };
  const setMockSubnavOpen = (isOpen: boolean) => {
    if (!mockDirectory || !guideNav || !guideLabelElement || !mockFolder || !mockSubnav) return;
    guideNav.hidden = isOpen;
    guideLabelElement.hidden = isOpen;
    mockSubnav.hidden = !isOpen;
  };
  mockFolder?.addEventListener('click', (event) => {
    event.preventDefault();
    setMockSubnavOpen(true);
    setMockPage('overview');
  });
  mockBack?.addEventListener('click', () => {
    restoreCurrentDocument();
    setMockSubnavOpen(false);
  });
  mockChildren.forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      setMockPage(link.dataset.mockChild ?? 'overview');
    });
  });
  searchInput?.addEventListener('input', () => {
    if (searchInput.value.trim()) setMockSubnavOpen(false);
  });
  const normalizeSearchText = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
  const searchEntries = navigationLinks.map((link) => ({ link, title: normalizeSearchText(link.textContent ?? '') }));
  const pageTextCache = new Map<string, Promise<string>>();
  let searchRevision = 0;

  const getPageText = (link: HTMLAnchorElement) => {
    if (link.getAttribute('aria-current') === 'page') {
      return Promise.resolve(normalizeSearchText(document.querySelector('#content')?.textContent ?? ''));
    }
    const cached = pageTextCache.get(link.href);
    if (cached) return cached;
    const result = fetch(link.href)
      .then((response) => response.text())
      .then((html) => {
        const page = new DOMParser().parseFromString(html, 'text/html');
        return normalizeSearchText(page.querySelector('#content')?.textContent ?? '');
      })
      .catch(() => '');
    pageTextCache.set(link.href, result);
    return result;
  };

  let searchTask: Promise<void> = Promise.resolve();
  const updateSearch = async () => {
    const revision = ++searchRevision;
    const query = normalizeSearchText(searchInput?.value.trim() ?? '');
    if (!query) {
      searchEntries.forEach(({ link }) => { link.hidden = false; });
      if (searchEmpty) searchEmpty.hidden = true;
      return;
    }
    searchEntries.forEach(({ link, title }) => {
      const isMatch = title.includes(query);
      link.hidden = !isMatch;
    });
    if (searchEmpty) searchEmpty.hidden = true;
    const pageTexts = await Promise.all(searchEntries.map(({ link }) => getPageText(link)));
    if (revision !== searchRevision) return;
    let matches = 0;
    searchEntries.forEach(({ link, title }, index) => {
      const isMatch = title.includes(query) || pageTexts[index].includes(query);
      link.hidden = !isMatch;
      if (isMatch) matches += 1;
    });
    if (searchEmpty) searchEmpty.hidden = matches > 0;
  };

  searchInput?.addEventListener('input', () => { searchTask = updateSearch(); });
  searchInput?.addEventListener('keydown', async (event) => {
    if (event.key === 'Escape') {
      searchInput.value = '';
      searchTask = updateSearch();
      searchInput.blur();
    } else if (event.key === 'Enter') {
      await searchTask;
      const firstMatch = searchEntries.find(({ link }) => !link.hidden)?.link;
      if (firstMatch) {
        firstMatch.click();
        searchInput.value = '';
        searchTask = updateSearch();
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    }
  });

  const tocAside = document.querySelector<HTMLElement>('.toc-sidebar');
  const tocList = document.querySelector<HTMLElement>('.toc-list');
  const articleHeadings = Array.from(document.querySelectorAll<HTMLElement>('#content .doc-section h3'))
    .filter((heading) => !heading.closest('.info-grid'));
  if (tocAside && tocList && articleHeadings.length >= 2) {
    const usedIds = new Set<string>();
    articleHeadings.forEach((heading, index) => {
      if (!heading.id) {
        const base = normalizeSearchText(heading.textContent ?? '')
          .replace(/[^\p{Letter}\p{Number}]+/gu, '-')
          .replace(/^-|-$/g, '') || `section-${index + 1}`;
        let id = base;
        let suffix = 2;
        while (usedIds.has(id) || document.getElementById(id)) id = `${base}-${suffix++}`;
        heading.id = id;
      }
      usedIds.add(heading.id);
      const link = document.createElement('a');
      link.className = 'toc-link';
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent?.trim() ?? '';
      link.dataset.tocId = heading.id;
      tocList.append(link);
    });
    tocAside.hidden = false;

    const tocLinks = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      const activeId = (visible.target as HTMLElement).id;
      tocLinks.forEach((link) => link.classList.toggle('active', link.dataset.tocId === activeId));
    }, { rootMargin: '-90px 0px -65% 0px', threshold: 0 });
    articleHeadings.forEach((heading) => observer.observe(heading));
  }
</script>
  </body>
</html>
