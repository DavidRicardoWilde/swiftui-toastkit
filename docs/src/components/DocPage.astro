interface Props {
  lang: 'en' | 'zh-cn' | 'zh-hant' | 'ja' | 'ko' | 'es';
  title: string;
  description: string;
  activePage?: string;
}

const { lang, title, description, activePage = 'overview' } = Astro.props;
const isDev = import.meta.env.DEV;
const CommunitySection = {
  en: CommunityEn,
  es: CommunityEs,
  ja: CommunityJa,
  ko: CommunityKo,
  'zh-cn': CommunityZhCn,
  'zh-hant': CommunityZhHant,
}[lang];
const sectionLabels: Record<Props['lang'], string[]> = {
  en: ['About ToastKit', 'Get started', 'Toast messages', 'Display duration', 'Gestures & actions', 'Styles & themes', 'Placement & width', 'Sizes', 'Dismissing toasts', 'Progress toasts', 'Accessibility', 'App localization', 'Project & community'],
  'zh-cn': ['项目介绍', '快速开始', 'Toast 消息', '显示时长', '手势与操作', '样式与主题', '位置与宽度', '尺寸', '移除 Toast', '进度 Toast', '辅助功能', '应用本地化', '项目与社区'],
  'zh-hant': ['專案介紹', '快速開始', 'Toast 訊息', '顯示時間', '手勢與操作', '樣式與主題', '位置與寬度', '尺寸', '移除 Toast', '進度 Toast', '輔助使用', '應用程式本地化', '專案與社群'],
  ja: ['ToastKit について', 'はじめに', 'Toast メッセージ', '表示時間', 'ジェスチャと操作', 'スタイルとテーマ', '配置と幅', 'サイズ', 'Toast を閉じる', '進捗 Toast', 'アクセシビリティ', 'アプリのローカライズ', 'プロジェクトとコミュニティ'],
  ko: ['ToastKit 소개', '시작하기', '토스트 메시지', '표시 시간', '제스처와 동작', '스타일과 테마', '위치와 너비', '크기', '토스트 닫기', '진행률 토스트', '접근성', '앱 현지화', '프로젝트와 커뮤니티'],
  es: ['Acerca de ToastKit', 'Primeros pasos', 'Mensajes toast', 'Duración', 'Gestos y acciones', 'Estilos y temas', 'Posición y ancho', 'Tamaños', 'Descartar toasts', 'Toasts de progreso', 'Accesibilidad', 'Localización de la app', 'Proyecto y comunidad'],
};
const guideLabel: Record<Props['lang'], string> = {
  en: 'GUIDES', 'zh-cn': '使用指南', 'zh-hant': '使用指南', ja: 'ガイド', ko: '가이드', es: 'GUÍAS',
};
const tocLabel: Record<Props['lang'], string> = {
  en: 'ON THIS PAGE', 'zh-cn': '本页目录', 'zh-hant': '本頁目錄', ja: 'このページ', ko: '이 페이지', es: 'EN ESTA PÁGINA',
};
const searchCopy: Record<Props['lang'], { placeholder: string; label: string; empty: string }> = {
  en: { placeholder: 'Search docs…', label: 'Search documentation', empty: 'No matching sections' },
  'zh-cn': { placeholder: '搜索文档…', label: '搜索文档', empty: '没有匹配的章节' },
  'zh-hant': { placeholder: '搜尋文件…', label: '搜尋文件', empty: '沒有符合的章節' },
  ja: { placeholder: 'ドキュメントを検索…', label: 'ドキュメントを検索', empty: '一致するセクションがありません' },
  ko: { placeholder: '문서 검색…', label: '문서 검색', empty: '일치하는 섹션이 없습니다' },
  es: { placeholder: 'Buscar documentación…', label: 'Buscar documentación', empty: 'No hay secciones coincidentes' },
};
const languageNames: Array<{ code: Props['lang']; label: string; native: string; href: string }> = [
  { code: 'en', label: 'English', native: 'EN', href: '/' },
  { code: 'zh-cn', label: '简体中文', native: '简体中文', href: '/zh-cn/' },
  { code: 'zh-hant', label: '繁體中文', native: '繁體中文', href: '/zh-hant/' },
  { code: 'ja', label: '日本語', native: '日本語', href: '/ja/' },
  { code: 'ko', label: '한국어', native: '한국어', href: '/ko/' },
  { code: 'es', label: 'Español', native: 'Español', href: '/es/' },
];
const htmlLang = lang === 'zh-hant' ? 'zh-Hant' : lang === 'zh-cn' ? 'zh-CN' : lang;
const sections = sectionLabels[lang].map((label, index) => [
  ['overview', 'start', 'messages', 'timing', 'actions', 'styling', 'layout', 'sizes', 'dismissing', 'progress', 'accessibility', 'localization', 'feedback'][index], label,
]);
const mockSubsectionLabels: Record<Props['lang'], string[]> = {
  en: ['GitHub', 'Discussions', 'Issues', 'Releases & changelog', 'Contributing'],
  'zh-cn': ['GitHub', '讨论', '问题反馈', '版本记录与更新日志', '参与贡献'],
  'zh-hant': ['GitHub', '討論', '問題回報', '版本記錄與更新日誌', '參與貢獻'],
  ja: ['GitHub', 'ディスカッション', 'Issue', 'リリースと変更履歴', 'コントリビュート'],
  ko: ['GitHub', '토론', '이슈', '릴리스 및 변경 기록', '기여하기'],
  es: ['GitHub', 'Debates', 'Incidencias', 'Versiones y cambios', 'Colaborar'],
};
const mockOverviewLabel: Record<Props['lang'], string> = {
  en: 'Community overview', 'zh-cn': '项目与社区概览', 'zh-hant': '專案與社群概覽', ja: 'プロジェクトとコミュニティの概要', ko: '프로젝트 및 커뮤니티 개요', es: 'Resumen del proyecto y la comunidad',
};
const mockCommunityDetails: Record<Props['lang'], Array<{ id: string; eyebrow: string; description: string; guidance: string; links: Array<{ label: string; href: string }> }>> = {
  en: [
    { id: 'github', eyebrow: 'SOURCE & PROJECT', description: 'ToastKit is an open-source SwiftUI library for stacked toast notifications on iOS.', guidance: 'Browse the source, sample app, documentation, and project history in the repository.', links: [{ label: 'Open repository', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: 'QUESTIONS & IDEAS', description: 'Use Discussions for usage questions, general feedback, and ideas that need conversation.', guidance: 'If a discussion reveals a concrete bug or feature request, continue in a GitHub Issue so it can be tracked.', links: [{ label: 'Open Discussions', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
    { id: 'issues', eyebrow: 'BUGS & FEATURE REQUESTS', description: 'Use an Issue for a reproducible problem or a specific feature request.', guidance: 'Include steps to reproduce, actual and expected results, and a minimal Swift example. The example may intentionally contain incorrect or non-compiling code. Add a screenshot or recording for visual issues, plus iOS/iPadOS, device or simulator, Xcode, Swift, and ToastKit versions.', links: [{ label: 'Create an Issue', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/issues/new/choose' }] },
    { id: 'changelog', eyebrow: 'TAGS, RELEASES & CHANGELOG', description: 'Use tags to identify the source for each version, Releases for published release notes, and the changelog for a version-by-version summary.', guidance: 'Compare a release with the previous tag when you need to review the exact code changes.', links: [{ label: 'Browse tags', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: 'View Releases', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: 'Read changelog', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: 'CONTRIBUTE', description: 'Contributions are welcome, including focused fixes, documentation improvements, and useful examples.', guidance: 'Please describe the change and validation performed in your pull request. The guide covers project conventions and review expectations.', links: [{ label: 'Read contributing guide', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
  'zh-cn': [
    { id: 'github', eyebrow: '源码与项目', description: 'ToastKit 是一个开源 SwiftUI 库，为 iOS 提供可堆叠的 Toast 通知。', guidance: '在仓库中查看源码、示例应用、文档和项目历史。', links: [{ label: '打开 GitHub 仓库', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: '问题与想法', description: '用 Discussions 交流使用问题、一般反馈，以及需要先讨论的想法。', guidance: '如果讨论中发现了明确的错误或功能需求，可以整理成 GitHub Issue 进行跟踪。', links: [{ label: '打开 Discussions', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
    { id: 'issues', eyebrow: '错误与功能请求', description: '使用 Issue 报告可复现的问题，或提出具体的功能请求。', guidance: '请写明复现步骤、实际结果和期望结果，并提供最小 Swift 示例。示例代码允许故意写成错误或无法编译的形式。视觉问题请附截图或录屏，并注明 iOS/iPadOS、设备或模拟器、Xcode、Swift 和 ToastKit 版本。', links: [{ label: '创建 GitHub Issue', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/issues/new/choose' }] },
    { id: 'changelog', eyebrow: 'TAG、RELEASES 与 CHANGELOG', description: '使用 tag 确认每个版本的源码，使用 Releases 查看发布说明，并通过 changelog 浏览逐版本的变更摘要。', guidance: '需要核对具体代码变化时，可以比较当前版本与上一个 tag。', links: [{ label: '浏览 tags', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: '查看 Releases', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: '查看变更日志', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: '参与贡献', description: '欢迎提交范围清晰的修复、文档改进和有帮助的示例。', guidance: '提交 Pull Request 时，请简要说明改动内容和验证方式。贡献指南列出了项目约定与审阅注意事项。', links: [{ label: '阅读贡献指南', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
  'zh-hant': [
    { id: 'github', eyebrow: '原始碼與專案', description: 'ToastKit 是一個開源 SwiftUI 函式庫，為 iOS 提供可堆疊的 Toast 通知。', guidance: '可在儲存庫中查看原始碼、示範 App、文件與專案歷史。', links: [{ label: '開啟 GitHub 儲存庫', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: '問題與想法', description: '使用 Discussions 交流使用問題、一般回饋，以及需要先討論的想法。', guidance: '若討論中發現明確的錯誤或功能需求，可整理成 GitHub Issue 追蹤。', links: [{ label: '開啟 Discussions', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
    { id: 'issues', eyebrow: '錯誤與功能請求', description: '使用 Issue 回報可重現的問題，或提出具體的功能請求。', guidance: '請提供重現步驟、實際結果與預期結果，以及最小 Swift 範例。範例程式碼可刻意寫成錯誤或無法編譯的形式。視覺問題請附截圖或錄影，並註明 iOS/iPadOS、裝置或模擬器、Xcode、Swift 與 ToastKit 版本。', links: [{ label: '建立 GitHub Issue', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/issues/new/choose' }] },
    { id: 'changelog', eyebrow: 'TAG、RELEASES 與 CHANGELOG', description: '透過 tag 確認各版本原始碼，透過 Releases 查看發布說明，並在 changelog 瀏覽各版本摘要。', guidance: '若要核對程式碼變化，可比較目前版本與前一個 tag。', links: [{ label: '瀏覽 tags', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: '查看 Releases', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: '查看變更日誌', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: '參與貢獻', description: '歡迎提交範圍明確的修正、文件改進與實用範例。', guidance: '提交 Pull Request 時，請簡述改動內容與驗證方式。貢獻指南說明了專案約定與審查注意事項。', links: [{ label: '閱讀貢獻指南', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
  ja: [
    { id: 'github', eyebrow: 'ソースとプロジェクト', description: 'ToastKit は iOS 向けのスタック可能な Toast 通知を提供する、オープンソースの SwiftUI ライブラリです。', guidance: 'リポジトリでソース、サンプルアプリ、ドキュメント、プロジェクトの履歴を確認できます。', links: [{ label: 'GitHub リポジトリを開く', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: '質問とアイデア', description: '使い方の質問、一般的なフィードバック、議論が必要なアイデアには Discussions を利用してください。', guidance: '具体的な不具合や機能要望になった場合は、GitHub Issue にまとめて追跡できます。', links: [{ label: 'Discussions を開く', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
    { id: 'issues', eyebrow: '不具合と機能要望', description: '再現可能な問題の報告や具体的な機能要望には Issue を利用してください。', guidance: '再現手順、実際の結果、期待する結果、最小限の Swift サンプルを記載してください。サンプルには意図的に誤ったコードやコンパイルできないコードも含められます。', links: [{ label: 'GitHub Issue を作成', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/issues/new/choose' }] },
    { id: 'changelog', eyebrow: 'タグ、リリース、変更履歴', description: 'タグで各バージョンのソースを確認し、Releases と変更履歴で更新内容を確認できます。', guidance: 'コードの差分を確認するには、現在のタグと直前のタグを比較してください。', links: [{ label: 'タグを見る', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/tags' }, { label: 'Releases を見る', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/releases' }, { label: '変更履歴を見る', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CHANGELOG.md' }] },
    { id: 'contributing', eyebrow: 'コントリビュート', description: '範囲を絞った修正、ドキュメントの改善、役立つサンプルを歓迎します。', guidance: 'Pull Request には変更内容と検証方法を簡潔に記載してください。', links: [{ label: '貢献ガイドを読む', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/blob/main/CONTRIBUTING.md' }] },
  ],
  ko: [
    { id: 'github', eyebrow: '소스 및 프로젝트', description: 'ToastKit은 iOS용 스택형 Toast 알림을 제공하는 오픈 소스 SwiftUI 라이브러리입니다.', guidance: '저장소에서 소스 코드, 샘플 앱, 문서와 프로젝트 이력을 확인할 수 있습니다.', links: [{ label: 'GitHub 저장소 열기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit' }] },
    { id: 'discussions', eyebrow: '질문 및 아이디어', description: '사용법 질문, 일반 피드백, 논의가 필요한 아이디어는 Discussions를 이용하세요.', guidance: '구체적인 버그나 기능 요청이 되면 GitHub Issue로 정리해 추적할 수 있습니다.', links: [{ label: 'Discussions 열기', href: 'https://github.com/DavidRicardoWilde/swiftui-toastkit/discussions' }] },
