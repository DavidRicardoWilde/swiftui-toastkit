---
import '../styles/global.css';
import CommunityEn from './sections/en/project-community.astro';
import CommunityEs from './sections/es/project-community.astro';
import CommunityJa from './sections/ja/project-community.astro';
import CommunityKo from './sections/ko/project-community.astro';
import CommunityZhCn from './sections/zh-cn/project-community.astro';
