---
import '../styles/global.css';

interface Props {
  lang: 'en' | 'zh-cn';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const zh = lang === 'zh-cn';
const sections = zh
  ? [
      ['start', '快速开始'],
      ['messages', 'Toast 消息'],
      ['timing', '显示时长'],
      ['actions', '手势与操作'],
      ['styling', '样式与主题'],
      ['layout', '位置与宽度'],
      ['accessibility', '辅助功能'],
      ['localization', '应用本地化'],
    ]
  : [
      ['start', 'Get started'],
      ['messages', 'Toast messages'],
      ['timing', 'Display duration'],
      ['actions', 'Gestures & actions'],
      ['styling', 'Styles & themes'],
      ['layout', 'Placement & width'],
      ['accessibility', 'Accessibility'],
      ['localization', 'App localization'],
    ];
const alternate = zh ? '/' : '/zh-cn/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={zh ? '/zh-cn/' : '/'} aria-label="ToastKit home">
        <span class="brand-mark">t</span>
        <span>ToastKit<span class="brand-docs"> / {zh ? '文档' : 'Docs'}</span></span>
      </a>
      <nav class="top-links" aria-label={zh ? '主导航' : 'Main navigation'}>
        <a href="https://github.com/DavidRicardoWilde/swiftui-toastkit">{zh ? 'GitHub' : 'GitHub'} <span aria-hidden="true">↗</span></a>
        <a class="locale-switch" href={alternate} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '简体中文'}</a>
      </nav>
    </header>

    <div class="shell">
      <aside class="sidebar">
        <p class="eyebrow">{zh ? '使用指南' : 'GUIDES'}</p>
        <nav aria-label={zh ? '文档章节' : 'Documentation sections'}>
          {sections.map(([id, label], index) => (
            <a href={`#${id}`} class:list={['side-link', index === 0 && 'selected']}>
              <span class="nav-number">{String(index + 1).padStart(2, '0')}</span>{label}
            </a>
          ))}
        </nav>
        <div class="sidebar-note">
          <span class="note-dot"></span>
          <p>{zh ? 'SwiftUI 原生构建' : 'Built for SwiftUI'}</p>
          <small>iOS 17+ · macOS 14+</small>
        </div>
      </aside>

      <main id="content">
        <slot />
        <footer class="footer">
          <span>ToastKit · SwiftUI notifications</span>
          <a href="https://github.com/DavidRicardoWilde/swiftui-toastkit">{zh ? '查看源码' : 'View source'} ↗</a>
        </footer>
      </main>
    </div>
  </body>
</html>
