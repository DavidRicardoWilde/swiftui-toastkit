---
import DocPage from '../../components/DocPage.astro';

const lang = 'ko' as const;
const sectionModules = import.meta.glob('../../components/sections/ko/*.astro', { eager: true });

export function getStaticPaths() {
  const labels = ['시작하기', '토스트 메시지', '표시 시간', '제스처와 동작', '스타일과 테마', '위치와 너비', '크기', '토스트 닫기', '진행률 토스트', '접근성', '앱 현지화', '프로젝트와 커뮤니티'];
  const ids = ['start', 'messages', 'timing', 'actions', 'styling', 'layout', 'sizes', 'dismissing', 'progress', 'accessibility', 'localization', 'feedback'];
  const slugs = ['get-started', 'toast-messages', 'display-duration', 'gestures-actions', 'styles-themes', 'placement-width', 'sizes', 'dismissing-toasts', 'progress-toasts', 'accessibility', 'app-localization', 'project-community'];
  return slugs.map((slug, index) => ({
    params: { section: slug },
    props: { id: ids[index], slug, title: labels[index] },
  }));
}

const { id, slug, title } = Astro.props;
const modulePath = `../../components/sections/ko/${slug}.astro`;
const SectionContent = (sectionModules[modulePath] as { default: any }).default;
const description = `${title} · ToastKit`;
---

<DocPage lang={lang} title={`${title} — ToastKit`} description={description} activePage={id}>
  <SectionContent />
</DocPage>
